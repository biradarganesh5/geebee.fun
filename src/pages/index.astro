---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.tsx';
import Avatar from '../components/Avatar.astro';
import AgeCounter from '../components/AgeCounter.tsx';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import HomelabSection from '../components/HomelabSection.astro';
import HobbiesSection from '../components/HobbiesSection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import ResumeSection from '../components/ResumeSection.astro';
import StatCounters from '../components/StatCounters.tsx';
import { profile } from '../content/profile';

/**
 * Static shell for the Portfolio_Site — a single centered column that composes
 * every section in order beneath a compact, minimal hero.
 *
 * Above-the-fold static content (name, description, nav targets) is
 * server-rendered so first paint does not depend on island hydration
 * (Req 1.1, 10.5). The hero is intentionally light (no full-screen image):
 * a short intro row (name + description + a live age line + avatar) with the
 * social row beneath it. The workspace photo — the full contained portrait
 * with its interactive HotspotLayer — is relocated into the About section as a
 * framed, height-capped showcase that preserves the intrinsic 3000:3878 aspect
 * ratio, so the HotspotLayer (which measures its own root) still maps hotspots
 * 1:1 onto their subjects.
 *
 * Section ownership:
 * - Body-only components (AboutSection, SkillsSection, ProjectsSection,
 *   HomelabSection, HobbiesSection, ResumeSection, ContactSection) are wrapped
 *   here in their `<section>` landmark + `<h2>`.
 * - CertificationsSection owns its own `<section id="certifications">` + `<h2>`,
 *   so it is rendered directly. Each nav-target section id (about, skills,
 *   experience, projects, homelab, hobbies, certifications, contact)
 *   therefore appears exactly once, alongside the non-target hero.
 */

// Section landmark + heading classes shared by the composed sections. Text
// sections stay narrow for readability; card grids can widen as needed.
const sectionClass = 'mx-auto max-w-2xl scroll-mt-24 px-4 py-8';
const wideSectionClass = 'mx-auto max-w-2xl scroll-mt-24 px-4 py-8';
const headingClass = 'text-3xl font-semibold tracking-tight md:text-4xl';
---

<Layout>
  <a
    href="#hero"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-foreground focus:px-4 focus:py-2 focus:text-background"
  >
    Skip to content
  </a>

  <!-- Site navigation. The Navigation island SSRs its desktop dock links so
       every nav target is present at first paint (Req 1.8) and hydrates for the
       magnification, mobile toggle + smooth scroll behavior (Req 1.9, 9.3, 9.4).
       The island owns its own fixed positioning (a bottom-centered floating
       dock at >=768px, a top-right toggle below it), so the header is a
       display:contents landmark that adds no box and never reserves an empty
       top bar or introduces horizontal scroll (Req 9.1). -->
  <header class="contents">
    <Navigation client:load />
  </header>

  <!-- Single centered column. Bottom padding keeps the last section clear of
       the fixed bottom dock. -->
  <main class="pb-40">
    <!-- Hero (not a nav target): a compact, above-the-fold-light intro. A row
         with the text block (name + description + a live age line) on one side
         and the avatar on the other, stacking on mobile, with the social row
         beneath. The name/description are server-rendered (Req 1.1, 10.5). -->
    <section
      id="hero"
      aria-labelledby="hero-heading"
      class="mx-auto max-w-2xl scroll-mt-24 px-4 pb-6 pt-16 md:pt-24"
    >
      <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10">
        <div class="order-2 text-center sm:order-1 sm:text-left">
          <h1
            id="hero-heading"
            class="text-4xl font-bold tracking-tight text-foreground md:text-5xl"
          >
            Hi, I'm Ganesh <span aria-hidden="true">👋</span>
          </h1>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-foreground md:text-xl">
            {profile.description}
          </p>
          <div
            class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-sm text-muted-foreground sm:justify-start"
          >
            <span class="flex items-center gap-1.5">
              {/* MapPin (lucide) — location */}
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>{profile.location}</span>
            </span>
            <span class="flex items-center gap-1.5">
              {/* Calendar (lucide) — age */}
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              <AgeCounter client:load />
            </span>
          </div>
        </div>

        <div class="order-1 sm:order-2">
          <Avatar
            src={profile.avatarUrl}
            alt="Ganesh Biradar"
            initials="GB"
            size={128}
          />
        </div>
      </div>
    </section>

    <!-- About_Section landmark + heading wrap the body-only AboutSection, then
         the relocated workspace-photo showcase: a centered, rounded, bordered
         frame that shows the FULL contained portrait with its interactive
         hotspots. The frame keeps the intrinsic 3000:3878 aspect ratio and is
         height-capped for in-section display (see the scoped `.workspace-frame`
         style), so the whole photo is visible and the HotspotLayer — which
         measures its own root — projects each hotspot 1:1 onto its subject. -->
    <section
      id="about"
      aria-labelledby="about-heading"
      class="mx-auto max-w-2xl scroll-mt-24 px-4 py-8"
    >
      <h2 id="about-heading" class={headingClass}>About</h2>
      <AboutSection />
    </section>

    <!-- Skills_Section landmark + heading wrap the body-only SkillsSection. -->
    <section id="skills" aria-labelledby="skills-heading" class={sectionClass}>
      <h2 id="skills-heading" class={headingClass}>Skills</h2>
      <SkillsSection />
    </section>

    <!-- Experience_Section landmark + heading wrap the animated stat counters
         and the body-only ResumeSection. StatCounters hydrate on scroll
         (client:visible); the final values are server-rendered so no-JS
         visitors and screen readers get the real numbers. -->
    <section
      id="experience"
      aria-labelledby="experience-heading"
      class={sectionClass}
    >
      <h2 id="experience-heading" class={headingClass}>Work Experience</h2>
      <StatCounters client:visible />
      <ResumeSection />
    </section>

    <!-- Certifications_Section owns its own section landmark and heading, so it
         is rendered directly here without a wrapping section. Placed right
         after Work Experience. -->
    <CertificationsSection />

    <!-- Projects_Section landmark + heading wrap the body-only ProjectsSection.
         Uses the wider wrapper for the card grid. -->
    <section
      id="projects"
      aria-labelledby="projects-heading"
      class={wideSectionClass}
    >
      <h2 id="projects-heading" class={headingClass}>Projects</h2>
      <ProjectsSection />
    </section>

    <!-- Homelab_Section landmark + heading wrap the body-only HomelabSection
         plus a before/after compare slider. The slider has no srcs yet, so it
         renders tasteful placeholders; it is capped at a sensible width. -->
    <section
      id="homelab"
      aria-labelledby="homelab-heading"
      class={sectionClass}
    >
      <h2 id="homelab-heading" class={headingClass}>Homelab</h2>
      <HomelabSection />
    </section>

    <!-- Hobbies_Section landmark + heading wrap the body-only HobbiesSection. -->
    <section
      id="hobbies"
      aria-labelledby="hobbies-heading"
      class={sectionClass}
    >
      <h2 id="hobbies-heading" class={headingClass}>Hobbies</h2>
      <HobbiesSection />
    </section>

    <!-- Contact_Section landmark + heading wrap the body-only ContactSection.
         Extra top margin + a divider set it apart as the closing/footer-like
         section rather than part of the main body flow. -->
    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="mx-auto mt-24 max-w-2xl scroll-mt-24 px-4 pb-8 pt-16 md:mt-32"
    >
      <h2 id="contact-heading" class={`${headingClass} text-center`}>Get in Touch</h2>
      <ContactSection />
    </section>
  </main>

</Layout>
