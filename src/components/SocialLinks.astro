---
import { profile } from '../content/profile';

/**
 * SocialLinks.astro — a horizontal row of social / contact icon links.
 *
 * Reads `profile.socials` from the profile content layer and renders each entry
 * as an icon-only link with a small, dependency-free inline SVG chosen by the
 * social `name` (GitHub, LinkedIn, Portfolio → globe, Email → envelope; an
 * unknown name falls back to the globe). Icons are 18px and paint in
 * `currentColor`, so they inherit the link color and flip correctly between the
 * light and dark themes.
 *
 * Accessibility / behavior:
 * - Every link is at least a 44x44px touch target and exposes `aria-label={name}`
 *   plus a `title` tooltip (the icon itself is `aria-hidden`).
 * - http(s) links open in a new tab with `rel="noopener noreferrer"`; `mailto:`
 *   links stay in-page with no target/rel.
 * - Colors use theme tokens (`text-muted-foreground`, `hover:text-foreground`).
 *
 * API:
 *   - `filterNavbar` when true, only socials flagged `navbar === true` are
 *                    shown; default false shows all.
 *   - `class`        extra classes for the container (a flex row).
 */
interface Props {
  /** When true, only show socials with `navbar === true`. Default: show all. */
  filterNavbar?: boolean;
  /** Extra classes for the flex-row container. */
  class?: string;
}

const { filterNavbar = false, class: className } = Astro.props;

const socials = filterNavbar
  ? profile.socials.filter((s) => s.navbar)
  : profile.socials;

// An http(s) link opens in a new tab; a mailto: link stays in-page.
const isExternal = (url: string) => /^https?:\/\//.test(url);

/**
 * Pick an inline SVG icon key from the social `name` (case-insensitive).
 * Unknown names fall back to the generic globe (a portfolio/site link).
 */
type IconKey = 'github' | 'linkedin' | 'globe' | 'email';
const iconFor = (name: string): IconKey => {
  const n = name.toLowerCase();
  if (n.includes('github')) return 'github';
  if (n.includes('linkedin')) return 'linkedin';
  if (n.includes('mail') || n.includes('email')) return 'email';
  return 'globe';
};
---

<ul class:list={['social-links', className]} role="list">
  {
    socials.map((social) => {
      const external = isExternal(social.url);
      const icon = iconFor(social.name);
      return (
        <li>
          <a
            class="social-links__link text-muted-foreground hover:text-foreground focus-visible:text-foreground"
            href={social.url}
            aria-label={social.name}
            title={social.name}
            {...(external
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {/* Dependency-free inline SVGs: 18px, currentColor. */}
            {icon === 'github' && (
              <svg
                class="social-links__icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.2-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.75.81 1.2 1.83 1.2 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
              </svg>
            )}
            {icon === 'linkedin' && (
              <svg
                class="social-links__icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.2.8 24 1.77 24h20.45c.98 0 1.78-.8 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z" />
              </svg>
            )}
            {icon === 'globe' && (
              <svg
                class="social-links__icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3c2.5 2.5 3.75 5.75 3.75 9S14.5 18.5 12 21c-2.5-2.5-3.75-5.75-3.75-9S9.5 5.5 12 3Z" />
              </svg>
            )}
            {icon === 'email' && (
              <svg
                class="social-links__icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            )}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  /* Horizontal flex row with gaps; wraps so there is no horizontal overflow on
     narrow viewports. */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* >=44x44 touch target. */
    min-height: 44px;
    min-width: 44px;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .social-links__link:focus-visible {
    outline: 2px solid rgb(var(--primary));
    outline-offset: 2px;
  }

  .social-links__icon {
    display: block;
  }
</style>
